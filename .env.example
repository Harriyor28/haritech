# =============================================
# HARITECH — Supabase Cloud Sync Configuration
# Copy this file to .env and fill in your values.
# =============================================

# 1. Supabase project URL (Project Settings -> API)
#    e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=YOUR-PROJECT-URL

# 2. Supabase anon public key (Project Settings -> API)
#    e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6...
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 3. The admin email you will sign in with (must match the RLS policy email in schema.sql)
VITE_ADMIN_EMAIL=admin@haritech.com
