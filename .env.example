# =============================================
# HARITECH - Enquiry Automation Configuration
# Copy this file to .env and fill in your values.
# =============================================

# ---- SAFE FOR THE BROWSER (VITE_ prefix = exposed to client) ----

# 1. Supabase project URL (Project Settings -> API)
#    e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=YOUR-PROJECT-URL

# 2. Supabase anon public key - public by design, protected by RLS
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 3. The admin email you will sign in with (must match the RLS policy email in schema.sql)
VITE_ADMIN_EMAIL=admin@haritech.com

# ---- SERVER-SIDE ONLY (Supabase Edge Function secrets) ----
# Set with:  npx supabase secrets set KEY=value   (from the supabase/ dir)
# NEVER put these in .env or any file committed to git.

# Resend transactional email (https://resend.com - free tier: 3,000 emails/month)
RESEND_API_KEY=

# Where owner notifications are sent (the business inbox)
OWNER_EMAIL=

# Verified sender in production, e.g. "Haritech Website <enquiries@yourdomain.com>"
# For testing before domain verification: onboarding@resend.dev (own-email only)
EMAIL_FROM=

# Business name used in the customer acknowledgement email
BUSINESS_NAME=Haritech Exclusive Business

# Random 48+ char string; must match the webhook Authorization header in Supabase Database Webhooks
FUNCTION_SECRET=